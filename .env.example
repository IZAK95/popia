# Copy to .env and fill in. Never commit .env.

# Your domain (Hetzner deployment only), e.g. popia.yourcompany.co.za – point an A record at the server first.
DOMAIN=popia.example.co.za

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# First admin account – created on first start only. Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Name shown in the authenticator app
OTP_ISSUER=POPIA Compliance

# Ubuntu encrypted vault (set automatically by: scripts/popia-vault.sh create)
# POPIA_DATA_DIR=/srv/popia-vault/data
# POPIA_BACKUP_DIR=/srv/popia-vault/backups
# REQUIRE_VAULT=1

# Email reminders (optional). A daily summary when a request, breach or task needs attention.
# Uses reference numbers only, never people's names. Leave EMAIL_HOST empty to turn reminders off.
# Example for Microsoft 365: EMAIL_HOST=smtp.office365.com, EMAIL_PORT=587. For Gmail use an app password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_FROM=popia@yourcompany.co.za
# Who gets the reminders (comma-separated). Empty: the Information Officer's email in the company profile.
# REMINDER_EMAIL=
# Hour of the day (0-23) from which the daily reminder may be sent.
# REMINDER_HOUR=7
