# Copy to .env and fill in. Never commit .env.

# Your domain (Hetzner deployment only), e.g. popia.yourcompany.co.za – point an A record at the server first.
DOMAIN=popia.example.co.za

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# First admin account – created on first start only. Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Name shown in the authenticator app
OTP_ISSUER=POPIA Compliance

# Ubuntu encrypted vault (set automatically by: scripts/popia-vault.sh create)
# POPIA_DATA_DIR=/srv/popia-vault/data
# POPIA_BACKUP_DIR=/srv/popia-vault/backups
# REQUIRE_VAULT=1
